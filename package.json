{
  "name": "codex-friendly-project-starter",
  "displayName": "Codex Friendly Project Starter",
  "version": "0.1.0",
  "publisher": "sunmax0731",
  "private": false,
  "description": "VS Code extension for highlighting AI agent documents and generating Codex-friendly first prompts.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunmax0731/codex-friendly-project-starter.git"
  },
  "bugs": {
    "url": "https://github.com/Sunmax0731/codex-friendly-project-starter/issues"
  },
  "homepage": "https://github.com/Sunmax0731/codex-friendly-project-starter#readme",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codex-friendly-project-starter.openStarter",
    "onCommand:codex-friendly-project-starter.generateFirstPrompt",
    "onCommand:codex-friendly-project-starter.invokeCodexWithFirstPrompt",
    "onCommand:codex-friendly-project-starter.invokeCodexWithCurrentPrompt",
    "onCommand:codex-friendly-project-starter.checkCodexCli",
    "onCommand:codex-friendly-project-starter.openCodexApp",
    "onCommand:codex-friendly-project-starter.refreshAgentDocs",
    "onCommand:codex-friendly-project-starter.refreshWorkItems",
    "onCommand:codex-friendly-project-starter.openWorkDashboard",
    "onCommand:codex-friendly-project-starter.openQcdsStatus",
    "onCommand:codex-friendly-project-starter.openMarkdownWebview",
    "onCommand:codex-friendly-project-starter.refreshMarkdownWebview",
    "onCommand:codex-friendly-project-starter.openMarkdownSource",
    "onCommand:codex-friendly-project-starter.copyMarkdownPath",
    "onCommand:codex-friendly-project-starter.scaffoldDefaultDocs",
    "onCommand:codex-friendly-project-starter.initializeIssuesDirectory",
    "onCommand:codex-friendly-project-starter.initializeTasksDirectory",
    "onCommand:codex-friendly-project-starter.createLocalIssue",
    "onCommand:codex-friendly-project-starter.createLocalTask",
    "onCommand:codex-friendly-project-starter.openWorkItemComposer",
    "onCommand:codex-friendly-project-starter.createWorkItemFromNaturalLanguage",
    "onCommand:codex-friendly-project-starter.openAgentDoc",
    "onCommand:codex-friendly-project-starter.openWorkItem",
    "onCommand:codex-friendly-project-starter.startWorkItemWithCodex",
    "onCommand:codex-friendly-project-starter.copyFirstPrompt",
    "onCommand:codex-friendly-project-starter.refreshAll",
    "onView:codexFriendlyAgentDocs",
    "onView:codexFriendlyWorkItems"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codex-friendly-project-starter.openStarter",
        "title": "Codex Starter: Open Project Starter",
        "icon": "$(rocket)"
      },
      {
        "command": "codex-friendly-project-starter.generateFirstPrompt",
        "title": "Codex Starter: Generate FirstPrompt",
        "icon": "$(sparkle)"
      },
      {
        "command": "codex-friendly-project-starter.copyFirstPrompt",
        "title": "Codex Starter: Copy FirstPrompt for VS Code Codex",
        "icon": "$(copy)"
      },
      {
        "command": "codex-friendly-project-starter.invokeCodexWithFirstPrompt",
        "title": "Codex Starter: Invoke AI Agent with FirstPrompt",
        "icon": "$(run)"
      },
      {
        "command": "codex-friendly-project-starter.invokeCodexWithCurrentPrompt",
        "title": "Codex Starter: Invoke AI Agent with Current Prompt",
        "icon": "$(run)"
      },
      {
        "command": "codex-friendly-project-starter.checkCodexCli",
        "title": "Codex Starter: Check Codex CLI",
        "icon": "$(terminal)"
      },
      {
        "command": "codex-friendly-project-starter.openCodexApp",
        "title": "Codex Starter: Open Codex App",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codex-friendly-project-starter.refreshAgentDocs",
        "title": "Codex Starter: Refresh Agent Docs",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-friendly-project-starter.refreshWorkItems",
        "title": "Codex Starter: Refresh Work Items",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-friendly-project-starter.refreshAll",
        "title": "Codex Starter: Refresh Agent Docs and Work Items",
        "icon": "$(sync)"
      },
      {
        "command": "codex-friendly-project-starter.openWorkDashboard",
        "title": "Codex Starter: Open Work Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "codex-friendly-project-starter.openQcdsStatus",
        "title": "Codex Starter: Open QCDS Status",
        "icon": "$(graph)"
      },
      {
        "command": "codex-friendly-project-starter.openMarkdownWebview",
        "title": "Codex Starter: Open Markdown WebView",
        "icon": "$(preview)"
      },
      {
        "command": "codex-friendly-project-starter.refreshMarkdownWebview",
        "title": "Codex Starter: Refresh Markdown WebView",
        "icon": "$(refresh)"
      },
      {
        "command": "codex-friendly-project-starter.openMarkdownSource",
        "title": "Codex Starter: Open Markdown Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codex-friendly-project-starter.copyMarkdownPath",
        "title": "Codex Starter: Copy Markdown Path",
        "icon": "$(copy)"
      },
      {
        "command": "codex-friendly-project-starter.scaffoldDefaultDocs",
        "title": "Codex Starter: Scaffold D:\\AI Default Docs",
        "icon": "$(repo-create)"
      },
      {
        "command": "codex-friendly-project-starter.initializeIssuesDirectory",
        "title": "Codex Starter: Initialize Issues Directory",
        "icon": "$(issues)"
      },
      {
        "command": "codex-friendly-project-starter.initializeTasksDirectory",
        "title": "Codex Starter: Initialize Tasks Directory",
        "icon": "$(tasklist)"
      },
      {
        "command": "codex-friendly-project-starter.createLocalIssue",
        "title": "Codex Starter: Create Local Issue",
        "icon": "$(add)"
      },
      {
        "command": "codex-friendly-project-starter.createLocalTask",
        "title": "Codex Starter: Create Local Task",
        "icon": "$(add)"
      },
      {
        "command": "codex-friendly-project-starter.openWorkItemComposer",
        "title": "Codex Starter: Open Work Item Composer",
        "icon": "$(new-file)"
      },
      {
        "command": "codex-friendly-project-starter.createWorkItemFromNaturalLanguage",
        "title": "Codex Starter: Create Work Item from Natural Language",
        "icon": "$(sparkle)"
      },
      {
        "command": "codex-friendly-project-starter.openAgentDoc",
        "title": "Codex Starter: Open Agent Doc",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codex-friendly-project-starter.openWorkItem",
        "title": "Codex Starter: Open Work Item",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codex-friendly-project-starter.startWorkItemWithCodex",
        "title": "Codex Starter: Start Work Item with Codex",
        "icon": "$(play)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codex-friendly-project-starter",
          "title": "Codex Starter",
          "icon": "resources/codex-starter.svg"
        }
      ]
    },
    "views": {
      "codex-friendly-project-starter": [
        {
          "id": "codexFriendlyAgentDocs",
          "name": "Agent Docs"
        },
        {
          "id": "codexFriendlyWorkItems",
          "name": "Work Items"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codex-friendly-project-starter.openStarter",
          "when": "view == codexFriendlyAgentDocs",
          "group": "navigation@1"
        },
        {
          "command": "codex-friendly-project-starter.scaffoldDefaultDocs",
          "when": "view == codexFriendlyAgentDocs",
          "group": "navigation@2"
        },
        {
          "command": "codex-friendly-project-starter.refreshAgentDocs",
          "when": "view == codexFriendlyAgentDocs",
          "group": "navigation@3"
        },
        {
          "command": "codex-friendly-project-starter.openMarkdownWebview",
          "when": "view == codexFriendlyAgentDocs",
          "group": "navigation@4"
        },
        {
          "command": "codex-friendly-project-starter.openWorkDashboard",
          "when": "view == codexFriendlyWorkItems",
          "group": "navigation@1"
        },
        {
          "command": "codex-friendly-project-starter.openWorkItemComposer",
          "when": "view == codexFriendlyWorkItems",
          "group": "navigation@2"
        },
        {
          "command": "codex-friendly-project-starter.refreshWorkItems",
          "when": "view == codexFriendlyWorkItems",
          "group": "navigation@3"
        },
        {
          "command": "codex-friendly-project-starter.refreshAll",
          "when": "view == codexFriendlyWorkItems",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "codex-friendly-project-starter.startWorkItemWithCodex",
          "when": "view == codexFriendlyWorkItems && viewItem == codexWorkItem",
          "group": "inline@1"
        },
        {
          "command": "codex-friendly-project-starter.openMarkdownWebview",
          "when": "view == codexFriendlyAgentDocs && viewItem == codexAgentDoc",
          "group": "inline@1"
        },
        {
          "command": "codex-friendly-project-starter.openMarkdownSource",
          "when": "view == codexFriendlyAgentDocs && viewItem == codexAgentDoc",
          "group": "navigation@1"
        },
        {
          "command": "codex-friendly-project-starter.copyMarkdownPath",
          "when": "view == codexFriendlyAgentDocs && viewItem == codexAgentDoc",
          "group": "navigation@2"
        },
        {
          "command": "codex-friendly-project-starter.openMarkdownWebview",
          "when": "view == codexFriendlyWorkItems && viewItem == codexWorkItem",
          "group": "inline@2"
        },
        {
          "command": "codex-friendly-project-starter.openMarkdownSource",
          "when": "view == codexFriendlyWorkItems && viewItem == codexWorkItem",
          "group": "navigation@1"
        },
        {
          "command": "codex-friendly-project-starter.copyMarkdownPath",
          "when": "view == codexFriendlyWorkItems && viewItem == codexWorkItem",
          "group": "navigation@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codexFriendlyAgentDocs",
        "contents": "Workspace 内の AGENTS.md / SKILL.md / README.md / docs を一覧化します。\n[Refresh](command:codex-friendly-project-starter.refreshAgentDocs) / [Project Starter](command:codex-friendly-project-starter.openStarter) / [D:\\AI Docs 生成](command:codex-friendly-project-starter.scaffoldDefaultDocs)"
      },
      {
        "view": "codexFriendlyWorkItems",
        "contents": "TODO.md / Issues / Tasks / QCDS を作業単位として可視化します。\n[Work Dashboard](command:codex-friendly-project-starter.openWorkDashboard) / [Work Item Composer](command:codex-friendly-project-starter.openWorkItemComposer) / [Refresh](command:codex-friendly-project-starter.refreshWorkItems)"
      }
    ],
    "configuration": {
      "title": "Codex Friendly Project Starter",
      "properties": {
        "codexFriendlyProjectStarter.defaultDomain": {
          "type": "string",
          "default": "WebApp",
          "description": "Default domain used when generating a first prompt."
        },
        "codexFriendlyProjectStarter.includeQcdsChecklist": {
          "type": "boolean",
          "default": true,
          "description": "Include D:\\AI QCDS and release-readiness checkpoints in generated prompts."
        },
        "codexFriendlyProjectStarter.codexCliPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI command or absolute path used when invoking AI Agents from VS Code."
        },
        "codexFriendlyProjectStarter.codexSandboxMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "description": "Sandbox mode passed to `codex exec`."
        },
        "codexFriendlyProjectStarter.codexGitWritePolicy": {
          "type": "string",
          "enum": [
            "preflight",
            "defer",
            "normal"
          ],
          "default": "preflight",
          "description": "Git write policy inserted into generated FirstPrompt and Work Item Start prompts. Use defer to avoid git add/commit/push when Codex cannot write .git/index.lock."
        },
        "codexFriendlyProjectStarter.codexModel": {
          "type": "string",
          "default": "",
          "description": "Optional model name passed to `codex exec -m`. Leave blank to use Codex CLI defaults."
        },
        "codexFriendlyProjectStarter.codexProfile": {
          "type": "string",
          "default": "",
          "description": "Optional Codex CLI profile passed to `codex exec -p`."
        },
        "codexFriendlyProjectStarter.useCodexForWorkItemInference": {
          "type": "boolean",
          "default": true,
          "description": "Use Codex CLI read-only inference when reflecting natural language into Work Item Composer fields."
        },
        "codexFriendlyProjectStarter.codexWorkItemInferenceTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "description": "Timeout in milliseconds for Codex CLI Work Item Composer inference before falling back to local inference."
        },
        "codexFriendlyProjectStarter.confirmBeforeCodexRun": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before starting `codex exec` from VS Code."
        },
        "codexFriendlyProjectStarter.markdownOpenMode": {
          "type": "string",
          "enum": [
            "webview",
            "source",
            "sideBySide"
          ],
          "default": "webview",
          "description": "How Agent Docs, TODO, Issues, and Tasks markdown files open from Codex Starter views."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-docs.ps1 && node tools/qcds-evaluate.cjs && node tools/platform-runtime-gate.mjs && node tools/vsix-readiness.mjs && node tools/closed-alpha-guard.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-docs.ps1",
    "validate": "npm test",
    "docs:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-docs.ps1",
    "platform:gate": "node tools/platform-runtime-gate.mjs",
    "release:check": "node tools/vsix-readiness.mjs",
    "closed-alpha:guard": "node tools/closed-alpha-guard.mjs"
  },
  "devDependencies": {},
  "license": "MIT",
  "keywords": [
    "codex",
    "ai-agent",
    "first-prompt",
    "vscodeextension",
    "qcds"
  ]
}
