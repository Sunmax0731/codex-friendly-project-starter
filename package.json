{
  "name": "codex-friendly-project-starter",
  "displayName": "Codex Friendly Project Starter",
  "version": "0.1.0",
  "publisher": "sunmax0731",
  "private": false,
  "description": "VS Code extension for highlighting AI agent documents and generating Codex-friendly first prompts.",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codex-friendly-project-starter.openStarter",
    "onCommand:codex-friendly-project-starter.generateFirstPrompt",
    "onCommand:codex-friendly-project-starter.invokeCodexWithFirstPrompt",
    "onCommand:codex-friendly-project-starter.invokeCodexWithCurrentPrompt",
    "onCommand:codex-friendly-project-starter.checkCodexCli",
    "onCommand:codex-friendly-project-starter.openCodexApp",
    "onCommand:codex-friendly-project-starter.refreshAgentDocs",
    "onCommand:codex-friendly-project-starter.refreshWorkItems",
    "onCommand:codex-friendly-project-starter.openWorkDashboard",
    "onCommand:codex-friendly-project-starter.openQcdsStatus",
    "onCommand:codex-friendly-project-starter.initializeIssuesDirectory",
    "onCommand:codex-friendly-project-starter.createLocalIssue",
    "onCommand:codex-friendly-project-starter.openWorkItem",
    "onView:codexFriendlyAgentDocs",
    "onView:codexFriendlyWorkItems"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codex-friendly-project-starter.openStarter",
        "title": "Codex Starter: Open Project Starter"
      },
      {
        "command": "codex-friendly-project-starter.generateFirstPrompt",
        "title": "Codex Starter: Generate FirstPrompt"
      },
      {
        "command": "codex-friendly-project-starter.invokeCodexWithFirstPrompt",
        "title": "Codex Starter: Invoke AI Agent with FirstPrompt"
      },
      {
        "command": "codex-friendly-project-starter.invokeCodexWithCurrentPrompt",
        "title": "Codex Starter: Invoke AI Agent with Current Prompt"
      },
      {
        "command": "codex-friendly-project-starter.checkCodexCli",
        "title": "Codex Starter: Check Codex CLI"
      },
      {
        "command": "codex-friendly-project-starter.openCodexApp",
        "title": "Codex Starter: Open Codex App"
      },
      {
        "command": "codex-friendly-project-starter.refreshAgentDocs",
        "title": "Codex Starter: Refresh Agent Docs"
      },
      {
        "command": "codex-friendly-project-starter.refreshWorkItems",
        "title": "Codex Starter: Refresh Work Items"
      },
      {
        "command": "codex-friendly-project-starter.openWorkDashboard",
        "title": "Codex Starter: Open Work Dashboard"
      },
      {
        "command": "codex-friendly-project-starter.openQcdsStatus",
        "title": "Codex Starter: Open QCDS Status"
      },
      {
        "command": "codex-friendly-project-starter.initializeIssuesDirectory",
        "title": "Codex Starter: Initialize Issues Directory"
      },
      {
        "command": "codex-friendly-project-starter.createLocalIssue",
        "title": "Codex Starter: Create Local Issue"
      },
      {
        "command": "codex-friendly-project-starter.openAgentDoc",
        "title": "Codex Starter: Open Agent Doc"
      },
      {
        "command": "codex-friendly-project-starter.openWorkItem",
        "title": "Codex Starter: Open Work Item"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codex-friendly-project-starter",
          "title": "Codex Starter",
          "icon": "resources/codex-starter.svg"
        }
      ]
    },
    "views": {
      "codex-friendly-project-starter": [
        {
          "id": "codexFriendlyAgentDocs",
          "name": "Agent Docs"
        },
        {
          "id": "codexFriendlyWorkItems",
          "name": "Work Items"
        }
      ]
    },
    "configuration": {
      "title": "Codex Friendly Project Starter",
      "properties": {
        "codexFriendlyProjectStarter.defaultDomain": {
          "type": "string",
          "default": "WebApp",
          "description": "Default domain used when generating a first prompt."
        },
        "codexFriendlyProjectStarter.includeQcdsChecklist": {
          "type": "boolean",
          "default": true,
          "description": "Include D:\\AI QCDS and release-readiness checkpoints in generated prompts."
        },
        "codexFriendlyProjectStarter.codexCliPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI command or absolute path used when invoking AI Agents from VS Code."
        },
        "codexFriendlyProjectStarter.codexSandboxMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "description": "Sandbox mode passed to `codex exec`."
        },
        "codexFriendlyProjectStarter.codexModel": {
          "type": "string",
          "default": "",
          "description": "Optional model name passed to `codex exec -m`. Leave blank to use Codex CLI defaults."
        },
        "codexFriendlyProjectStarter.codexProfile": {
          "type": "string",
          "default": "",
          "description": "Optional Codex CLI profile passed to `codex exec -p`."
        },
        "codexFriendlyProjectStarter.confirmBeforeCodexRun": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before starting `codex exec` from VS Code."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-docs.ps1 && node tools/qcds-evaluate.cjs && node tools/platform-runtime-gate.mjs && node tools/closed-alpha-guard.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-docs.ps1",
    "validate": "npm test",
    "docs:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-docs.ps1",
    "platform:gate": "node tools/platform-runtime-gate.mjs",
    "closed-alpha:guard": "node tools/closed-alpha-guard.mjs"
  },
  "devDependencies": {},
  "license": "MIT",
  "keywords": [
    "codex",
    "ai-agent",
    "first-prompt",
    "vscodeextension",
    "qcds"
  ]
}
